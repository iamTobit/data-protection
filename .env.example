# Flask Application Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=odpc-compliance-audit-secret-key-change-in-production
PORT=5000

# Database Configuration (PostgreSQL / Supabase)
# For Supabase Direct: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For Supabase Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# For Local Postgres: postgresql://postgres:postgres@localhost:5432/odpc_compliance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/odpc_compliance

# AI & LLM Inference Configuration
# Supported providers:
#   - 'openai' (Standard OpenAI API: gpt-4o, gpt-4o-mini)
#   - 'openai_compatible' (Ollama, Groq, Together, DeepSeek, vLLM)
#   - 'huggingface' (Hugging Face Inference API / local endpoint)
#   - 'mock' (Built-in rule-based heuristic auditor fallback when no API key is available)
LLM_PROVIDER=openai
LLM_API_KEY=your-openai-or-compatible-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Safaricom Daraja M-Pesa API Configuration
# Options: 'sandbox' or 'production'
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret

# Lipa Na M-Pesa Online Shortcode (174379 is the default Safaricom Daraja sandbox business shortcode)
MPESA_SHORTCODE=174379

# Passkey from Safaricom Daraja Developer Portal
# (Default sandbox passkey provided below for immediate sandbox testing)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Safaricom Webhook Callback URL: Must be a publicly reachable HTTPS endpoint
# In local development, forward via ngrok: e.g. https://your-subdomain.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.ngrok-free.app/api/mpesa/callback

# Price in KES to unlock full audit report and compliant policy rewrite
REPORT_UNLOCK_PRICE_KES=1000
