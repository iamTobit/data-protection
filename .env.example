# Flask Application Configuration
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_SECRET_KEY=generate-a-secure-random-32-byte-secret-hex
PORT=5000

# Database Configuration (PostgreSQL / Supabase Session Pooler)
# Session Pooler (Port 5432): postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/odpc_compliance

# AI & LLM Inference Configuration (Groq / OpenAI)
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1

# Safaricom Daraja M-Pesa Configuration ('sandbox' or 'production')
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Safaricom Webhook Callback URL: Production domain URL (e.g. Railway URL)
MPESA_CALLBACK_URL=https://your-production-app.up.railway.app/api/mpesa/callback

# Price in KES to unlock full audit report and compliant policy rewrite
REPORT_UNLOCK_PRICE_KES=1000
